{
  "name": "aitufood",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "AituFood: lunch pre-order system for AITU cafes (React + Firebase)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && firebase deploy --only hosting,firestore:rules,firestore:indexes",
    "seed:reset": "node scripts/seed.mjs --reset",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-aitufood-tests \"node --test tests/rules.test.mjs\"",
    "test:results": "node scripts/test_results.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-admin": "^13.4.0",
    "firebase-tools": "^14.11.0",
    "tailwindcss": "^4.1.11",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@firebase/util@1.12.1": true,
    "protobufjs@7.6.6": true
  }
}
